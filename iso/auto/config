#!/bin/sh
# live-build configuration for SOS OS. Invoked by `lb config` from iso/.
# SOS_VERSION is exported by scripts/build-iso.sh.
set -e

SOS_VERSION="${SOS_VERSION:-0.0.0}"
# ISO 9660 volume IDs are limited to 32 upper-case characters.
SOS_VOLUME="SOS_OS_$(echo "$SOS_VERSION" | tr '.-' '__' | tr '[:lower:]' '[:upper:]')"

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --parent-archive-areas "main contrib non-free-firmware" \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-chroot-security "http://security.debian.org/debian-security/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --security true \
    --updates true \
    --apt-recommends true \
    --apt-indices false \
    --cache true \
    --cache-packages true \
    --cache-stages "bootstrap" \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --uefi-secure-boot enable \
    --debian-installer none \
    --firmware-chroot false \
    --firmware-binary false \
    --chroot-squashfs-compression-type xz \
    --iso-application "SOS OS" \
    --iso-publisher "SOS OS Project" \
    --iso-preparer "live-build; SOS OS build scripts" \
    --iso-volume "$SOS_VOLUME" \
    --image-name "sos-os-${SOS_VERSION}" \
    --bootappend-live "boot=live components quiet splash live-config.username=sos live-config.user-fullname=SOS_Live_User live-config.hostname=sos-os locales=en_US.UTF-8 keyboard-layouts=us" \
    --memtest none \
    "${@}"
