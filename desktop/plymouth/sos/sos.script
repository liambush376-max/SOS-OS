# SOS OS Plymouth script theme.
# Images (rendered at package build time): logo.png, dot.png

Window.SetBackgroundTopColor(0.020, 0.024, 0.059);
Window.SetBackgroundBottomColor(0.047, 0.039, 0.141);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen_h / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetZ(10);

# Five progress dots under the logo
dot_image = Image("dot.png");
NUM_DOTS = 5;
for (i = 0; i < NUM_DOTS; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetX(screen_w / 2 + (i - 2) * 24 - dot_image.GetWidth() / 2);
    dots[i].SetY(screen_h / 2 + logo.image.GetHeight() / 2 + 10);
    dots[i].SetOpacity(0.25);
}

frame = 0;
fun refresh_callback() {
    frame++;
    # Gentle pulse on the logo (period ~2.5 s at 50 fps)
    logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(frame / 20));
    active = Math.Int(frame / 10) % NUM_DOTS;
    for (i = 0; i < NUM_DOTS; i++) {
        if (i == active) dots[i].SetOpacity(1);
        else dots[i].SetOpacity(0.25);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---- Password prompt (LUKS full-disk encryption) ----------------------------
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    p_image = Image.Text(prompt, 0.9, 0.91, 1.0);
    prompt_sprite.SetImage(p_image);
    prompt_sprite.SetX(screen_w / 2 - p_image.GetWidth() / 2);
    prompt_sprite.SetY(screen_h * 0.72);
    prompt_sprite.SetOpacity(1);

    text = "";
    for (i = 0; i < bullets; i++) text += "●";
    if (bullets == 0) text = " ";
    b_image = Image.Text(text, 0.18, 0.48, 1.0);
    bullets_sprite.SetImage(b_image);
    bullets_sprite.SetX(screen_w / 2 - b_image.GetWidth() / 2);
    bullets_sprite.SetY(screen_h * 0.72 + 30);
    bullets_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---- Status messages (e.g. fsck) ---------------------------------------------
message_sprite = Sprite();
fun message_callback(text) {
    m_image = Image.Text(text, 0.55, 0.57, 0.73);
    message_sprite.SetImage(m_image);
    message_sprite.SetX(screen_w / 2 - m_image.GetWidth() / 2);
    message_sprite.SetY(screen_h - 60);
}
Plymouth.SetMessageFunction(message_callback);
